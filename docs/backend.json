{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user's unique ID from Firebase Auth." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "displayName": { "type": "string", "description": "The user's display name." },
        "photoURL": { "type": "string", "format": "uri", "description": "URL of the user's profile picture." },
        "isAdmin": { "type": "boolean", "description": "Flag to indicate if the user is an admin." }
      },
      "required": ["uid", "email"]
    },
    "Listing": {
      "title": "Property Listing",
      "description": "Represents a property listing submitted by a user.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "address": { "type": "string" },
        "type": { "type": "string", "enum": ["Apartment", "Shared", "House", "Villa"] },
        "price": { "type": "number" },
        "imageUrls": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "imageHint": { "type": "string" },
        "facilities": { "type": "array", "items": { "type": "string" } },
        "ownerId": { "type": "string", "description": "UID of the user who owns the listing." },
        "status": { "type": "string", "enum": ["pending", "approved", "sold"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "soldAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "location", "address", "type", "price", "imageUrls", "ownerId", "status", "createdAt"]
    },
    "Payment": {
      "title": "Payment Record",
      "description": "Represents a payment transaction for a listing.",
      "type": "object",
      "properties": {
        "listingId": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "receiptUrl": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["listingId", "userId", "amount", "receiptUrl", "createdAt"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores public profiles for all users."
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/Listing" },
      "description": "Stores all property listings."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Stores records of all payments made."
    }
  }
}
