/**
 * @fileoverview Firestore Security Rules for JVHouzin Application
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and admin role management.
 * Listings are accessible to all, but creating, updating, and deleting listings is restricted to the owner (creator) of the listing.
 * Payments are restricted to the user associated with the payment.
 *
 * Data Structure:
 * - /users/{userId}: Stores private user profile data, accessible only to the user themselves.
 * - /listings/{listingId}: Stores property listing data, readable by everyone, but writable only by the listing owner.
 * - /listings/{listingId}/payments/{paymentId}: Stores payment data, restricted to the user who made the payment.
 * - /roles_admin/{userId}: Indicates admin status, accessible only to admins.
 *
 * Key Security Decisions:
 * - User listing is disallowed for privacy.
 * - Listings are publicly readable to maximize visibility.
 * - The security posture defaults to strict owner-only access unless explicitly opened up.
 *
 * Denormalization for Authorization:
 * - The `listings` documents contain a `userId` field, allowing us to easily verify the owner without needing to perform additional reads.
 * - The `payments` documents also contain a `userId` field, for the same reason.
 *
 * Structural Segregation:
 * - Private user data is stored under `/users/{userId}`, separate from the public `/listings` collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (create) - Authenticated user with matching user ID can create their profile.
     * @allow (get, update, delete) - Authenticated user with matching user ID can read, update, or delete their profile.
     * @deny (create) - Authenticated user trying to create a profile with a different user ID.
     * @deny (get, update, delete) - Authenticated user trying to read, update, or delete another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to property listing data.
     * @path /listings/{listingId}
     * @allow (get, list) - Anyone can read the listing.
     * @allow (create) - Authenticated user can create a listing with their user ID.
     * @allow (update, delete) - Only the owner (creator) of the listing can update or delete it.
     * @deny (create) - Authenticated user trying to create a listing with a different user ID.
     * @deny (update, delete) - Authenticated user trying to update or delete a listing they don't own.
     * @principle Enforces document ownership for writes.
     */
    match /listings/{listingId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner() {
        return resource.data.userId == request.auth.uid;
      }
       function isNewOwner() {
        return request.resource.data.userId == request.auth.uid;
      }
      function isExistingOwner() {
        return isOwner() && resource != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isNewOwner();
      allow update: if isSignedIn() && isExistingOwner();
      allow delete: if isSignedIn() && isExistingOwner();
    }

    /**
     * @description Controls access to payment records for property listings.
     * @path /listings/{listingId}/payments/{paymentId}
     * @allow (get, list) - Only the user associated with the payment can read and list it.
     * @allow (create) - Authenticated user can create a payment record associated with their user ID.
     * @allow (update, delete) - Only the user associated with the payment can update or delete it.
     * @deny (create) - Authenticated user trying to create a payment record with a different user ID.
     * @deny (update, delete) - Authenticated user trying to update or delete a payment record they don't own.
     * @principle Enforces document ownership for writes.
     */
    match /listings/{listingId}/payments/{paymentId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner() {
        return resource.data.userId == request.auth.uid;
      }
      function isNewOwner() {
        return request.resource.data.userId == request.auth.uid;
      }
      function isExistingOwner() {
        return isOwner() && resource != null;
      }

      allow get: if isSignedIn() && isOwner();
      allow list: if isSignedIn() && isOwner();
      allow create: if isSignedIn() && isNewOwner();
      allow update: if isSignedIn() && isExistingOwner();
      allow delete: if isSignedIn() && isExistingOwner();
    }

     /**
      * @description Controls access to admin role data.
      * @path /roles_admin/{userId}
      * @allow (create) - Only an admin can create a new admin role.
      * @allow (get) - Only the admin user can get their own admin role.
      * @allow (update, delete) - No updates or deletes are allowed for admin roles.
      * @deny (create) - Non-admins cannot create admin roles.
      * @deny (get) - Non-admin user cannot get an admin role.
      * @deny (update, delete) - No one can update or delete admin roles.
      * @principle Enforces admin-only access.
      */
    match /roles_admin/{userId} {
        function isSignedIn() {
            return request.auth != null;
        }

        // Placeholder for Admin role check, needs to be implemented elsewhere.
        function isAdmin() {
            return true;
        }

        function isOwner(userId) {
            return request.auth.uid == userId;
        }

        allow get: if isSignedIn() && isOwner(userId) && isAdmin();
        allow list: if false;
        allow create: if isSignedIn() && isAdmin() && isOwner(userId);
        allow update: if false;
        allow delete: if false;
    }
  }
}