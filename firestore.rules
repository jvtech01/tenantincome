/**
 * @file Firebase Security Rules for JVHouzin Application
 *
 * @core_philosophy This ruleset enforces a hybrid security model. User data is strictly controlled via
 *   ownership, listings are publicly readable but owner-writeable, and payments are linked to both listings and users.
 *   Admin roles are managed via a dedicated collection.
 *
 * @data_structure The Firestore database is structured as follows:
 *   - `/users/{userId}`: Stores user profile data, accessible only to the user themselves.
 *   - `/listings/{listingId}`: Stores property listing data, publicly readable but only editable by the listing owner.
 *   - `/listings/{listingId}/payments/{paymentId}`: Stores payment information, accessible only to the user who made the payment.
 *   - `/roles_admin/{userId}`: Indicates admin privileges. The existence of a document grants admin access.
 *
 * @key_security_decisions
 *   - User listing is explicitly denied.
 *   - Public read access is granted for the `/listings` collection.
 *   - Owner-only write access is enforced on `/listings` using the denormalized `userId` field.
 *   - Subcollections inherit authorization from their parent documents.
 *
 * @denormalization_for_authorization
 *   - The `listings` documents have a `userId` field, which enables direct ownership checks without additional reads.
 *   - The `payments` documents denormalize the `userId` from the listing, so we can authorize against the parent listing's writer.
 *
 * @structural_segregation
 *   - User data is segregated under `/users/{userId}`.
 *   - Public listing data is stored under `/listings/{listingId}`.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Only the authenticated user can read or write their own profile.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile.
     *   - request.auth.uid: 'user123'
     *   - request.resource.data.id: 'user123'
     * @allow (get, update, delete) User with ID 'user123' can read and modify their own profile.
     *   - request.auth.uid: 'user123'
     *   - resource.data.id: 'user123'
     * @deny (create, update, delete) User with ID 'user456' cannot modify user 'user123' profile.
     *   - request.auth.uid: 'user456'
     *   - resource.data.id: 'user123'
     * @principle Enforces document ownership for writes and reads.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // User listing is not permitted

      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow delete: if isOwner(userId);
    }

    /**
     * @description Secure property listings.  Listings are publicly readable, but only the owner can create, update, or delete them.
     * @path /listings/{listingId}
     * @allow (get, list) Any user can read any listing.
     * @allow (create) User with ID 'user123' can create a listing with their ID as the owner.
     *   - request.auth.uid: 'user123'
     *   - request.resource.data.userId: 'user123'
     * @allow (update, delete) User with ID 'user123' can update/delete a listing they own.
     *   - request.auth.uid: 'user123'
     *   - resource.data.userId: 'user123'
     * @deny (create) User with ID 'user456' cannot create a listing for user 'user123'.
     *   - request.auth.uid: 'user456'
     *   - request.resource.data.userId: 'user123'
     * @deny (update, delete) User with ID 'user456' cannot modify a listing owned by user 'user123'.
     *   - request.auth.uid: 'user456'
     *   - resource.data.userId: 'user123'
     * @principle Public read access with owner-only writes.
     */
    match /listings/{listingId} {
      allow get, list: if true;

      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    /**
     * @description Secure payment records for listings. Only the user associated with the listing can create, update, or delete payments.
     * @path /listings/{listingId}/payments/{paymentId}
     * @allow (create) User with ID 'user123' can create a payment for a listing where they are the owner.
     *   - request.auth.uid: 'user123'
     *   - get(/databases/$(database)/documents/listings/$(listingId)).data.userId: 'user123'
     * @allow (get, list) Any user can read the payment
     * @allow (update, delete) User with ID 'user123' can update/delete a payment for a listing they own.
     *   - request.auth.uid: 'user123'
     *   - get(/databases/$(database)/documents/listings/$(listingId)).data.userId: 'user123'
     * @deny (create) User with ID 'user456' cannot create a payment for a listing owned by user 'user123'.
     *   - request.auth.uid: 'user456'
     *   - get(/databases/$(database)/documents/listings/$(listingId)).data.userId: 'user123'
     * @deny (update, delete) User with ID 'user456' cannot modify a payment for a listing owned by user 'user123'.
     *   - request.auth.uid: 'user456'
     *   - get(/databases/$(database)/documents/listings/$(listingId)).data.userId: 'user123'
     * @principle Inherits authorization from the parent `listing` document, enforcing owner-only access.
     */
    match /listings/{listingId}/payments/{paymentId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isOwnerOfListing(listingId);
      allow update: if isSignedIn() && isOwnerOfListing(listingId);
      allow delete: if isSignedIn() && isOwnerOfListing(listingId);
    }
     /**
      * @description Allows admins to manage user roles.  If a document exists for a user in this collection, that user is considered an admin.
      * @path /roles_admin/{userId}
      * @allow (get) Any user can read the payments
      * @allow (list) Any user can read the payments
      * @allow (create, update, delete) Only an admin can create, update or delete admin status.
      * @deny User without admin role try to create, update or delete admin role.
      * @principle Admin role-based access control.
      */
       match /roles_admin/{userId} {
        allow get, list: if isAdmin();
        allow create, update, delete: if isAdmin();
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isSignedIn() && resource.data.id == request.auth.uid;
    }

    function isOwnerOfListing(listingId) {
        return get(/databases/$(database)/documents/listings/$(listingId)).data.userId == request.auth.uid;
    }

    function isExistingOwnerOfListing(userId) {
      return isSignedIn() && resource != null && resource.data.userId == request.auth.uid;
    }

    function isExistingOwnerOfListingPayment(listingId) {
      return resource != null && get(/databases/$(database)/documents/listings/$(listingId)).data.userId == request.auth.uid;
    }

     function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}