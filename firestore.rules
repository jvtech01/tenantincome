/**
 * @fileoverview Firestore Security Rules for Property Listings App.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing strict ownership and role-based access control.
 * Public read access is granted to the 'listings' collection.  Writes are limited to authenticated users with appropriate ownership.
 * User profiles are protected, with only the authenticated user having write access to their own profile.
 * Payments are restricted to authenticated users and are generally read-only except for creation.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information.
 * - /listings/{listingId}: Stores property listings.
 *   - Each listing has an `ownerId` field that MUST match the user ID of the listing creator.
 * - /payments/{paymentId}: Stores payment records.
 *   - The listingId and userId are used to maintain payment history.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Anyone can list all listings.
 * - Only listing owners can modify or delete their listings.
 * - Payments can be created by anyone.
 * - Payments can only be read.
 *
 * Denormalization for Authorization:
 * - The `Listing` entity denormalizes the `ownerId` to enable simple owner-based access control.
 * - The `Payment` entity denormalizes the `listingId` and `userId` to enable payment access control.
 *
 * Structural Segregation:
 * - Public listings are stored in the top-level `listings` collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated (user is signed in).
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user owns the resource (based on the `ownerId` field).
     */
    function isResourceOwner(ownerId) {
        return isSignedIn() && request.auth.uid == ownerId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the existing resource.
     */
    function isExistingOwner(ownerId) {
      return isResourceOwner(ownerId) && resource != null;
    }

    match /users/{userId} {
      /**
       * @description Allows users to read and write their own profile data.
       * @path /users/{userId}
       * @allow (get, create, update, delete) if the authenticated user's ID matches the userId.
       * @deny (get, create, update, delete) if the authenticated user is not signed in.
       * @principle Enforces user-ownership for profile data.
       */
      allow get: if true;
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    match /listings/{listingId} {
      /**
       * @description Allows anyone to read listings, but restricts creation, updates, and deletion to the listing owner.
       * @path /listings/{listingId}
       * @allow (get, list) if true (public read access).
       * @allow (create) if the authenticated user's ID matches the listing's `ownerId` field.
       * @allow (update, delete) if the authenticated user is the owner of the listing.
       * @deny (create, update, delete) if the authenticated user is not the listing owner or not signed in.
       * @principle Enforces owner-only writes with public read access.
       */
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    match /payments/{paymentId} {
      /**
       * @description Allows creating payments, but restricts updates and deletion.
       * @path /payments/{paymentId}
       * @allow (get, list) if true.
       * @allow (create) if isSignedIn().
       * @deny (update, delete) at all times.
       * @principle Limits writes to payment creation and restricts modification.
       */
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}