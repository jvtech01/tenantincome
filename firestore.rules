/**
 * @fileoverview Firestore Security Rules for JVHouzin application.
 *
 * Core Philosophy:
 * This ruleset prioritizes authorization independence by denormalizing authorization data (userId)
 * directly into documents. This avoids costly `get()` calls and simplifies security checks. The rules
 * enforce a user-ownership model for user-specific data and allows public read access with
 * owner-only writes for listings. Administrative privileges are managed through the `roles_admin`
 * collection.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. User-owned data.
 * - /listings/{listingId}: Stores property listings. Publicly readable, owner-writable.
 * - /listings/{listingId}/payments/{paymentId}: Stores payment records. Owner writable via userId denormalization.
 * - /roles_admin/{userId}: Indicates admin privileges.
 *
 * Key Security Decisions:
 * - Listings are publicly readable to facilitate discovery, but only the owner can create, update, or delete them.
 * - Payments are secured using the owner of the listing, through userId denormalization.
 * - User listing is disabled.
 * - Data type validation is relaxed to enable rapid prototyping, focusing on ownership and relational integrity.
 *
 * Denormalization for Authorization:
 * - Listings contain a 'userId' field, denormalized from the user who created the listing, to allow owner-only write access without `get()` calls.
 * - Payments contain a 'userId' field, denormalized from the associated listing, to allow owner-only write access without `get()` calls.
 *
 * Structural Segregation:
 * - Private user data is stored under /users/{userId}, separate from public listings in /listings/{listingId}.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function isAdmin() {
          return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    /**
     * @description Secure user profiles under /users/{userId}.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile.
     * @allow (get) User with ID 'user123' can retrieve their own profile.
     * @deny (create) User with ID 'user456' cannot create a profile for 'user123'.
     * @deny (update) User with ID 'user456' cannot update the profile of 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines security rules for the /listings/{listingId} collection.
     * @path /listings/{listingId}
     * @allow (get, list) Any user can view listings.
     * @allow (create) Authenticated user can create a listing with their userId.
     * @allow (update, delete) Only the user who created the listing can update or delete it.
     * @deny (create) Unauthenticated user cannot create a listing.
     * @deny (update, delete) User 'otherUser' cannot update/delete a listing created by 'ownerUser'.
     * @principle Allows public read access with owner-only writes.
     */
    match /listings/{listingId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.userId);
      allow delete: if isExistingOwner(resource.data.userId);
    }

    /**
     * @description Secures payment records for each listing under /listings/{listingId}/payments/{paymentId}.
     * @path /listings/{listingId}/payments/{paymentId}
     * @allow (create) User who owns the listing can create a payment record.
     * @allow (get, list) Any user can view payments of a listing.
     * @allow (update, delete) Only the user who owns the listing can update or delete payment records.
     * @deny (create) User 'otherUser' cannot create a payment for a listing owned by 'ownerUser'.
     * @deny (update, delete) User 'otherUser' cannot update/delete a payment for a listing owned by 'ownerUser'.
     * @principle Enforces owner-only writes based on the listing's userId.
     */
    match /listings/{listingId}/payments/{paymentId} {
      allow get, list: if true;
      allow create: if isSignedIn() && get(/databases/$(database)/documents/listings/$(listingId)).data.userId == request.auth.uid;
      allow update: if isSignedIn() && get(/databases/$(database)/documents/listings/$(listingId)).data.userId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/listings/$(listingId)).data.userId == request.auth.uid && resource != null;
    }

     /**
      * @description Grants admin access based on the document's existence in /roles_admin/{userId}.
      * @path /roles_admin/{userId}
      * @allow (read, write) Only users listed in this collection can manage admin roles.
      * @deny (read, write) Non-admin users cannot access or modify this collection.
      * @principle Restricts admin role management to authorized users.
      */
    match /roles_admin/{userId} {
       allow get: if isAdmin();
       allow list: if false;
       allow create: if isAdmin();
       allow update: if false;
       allow delete: if isAdmin();
    }
  }
}